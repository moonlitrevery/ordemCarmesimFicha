# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# biblioteca estática da Mesa: gerados por npm run vtt:manifest
/generated/
/public/vtt/_built/

# gerador de mapas (maps/): saída local e texturas baixadas por npm run maps:assets
/maps/out/
/maps/assets/textures/*
!/maps/assets/textures/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files: qualquer .env fica fora; só o exemplo (placeholders) entra
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Copiado do pdfjs-dist no dev e no build
/public/pdfjs/
