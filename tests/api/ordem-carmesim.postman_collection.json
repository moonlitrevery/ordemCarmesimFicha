              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/characters"
            },
            "description": "RNF-01. Negativo (RLS characters_insert).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_id\": \"00000000-0000-4000-8000-000000000000\",\n  \"name\": \"Intrusa\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('recusado (401 ou 403)', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));",
                  "pm.test('erro de RLS (42501)', () => pm.expect(pm.response.json().code).to.eql('42501'));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-08 Editar ocupação (CT-13)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
