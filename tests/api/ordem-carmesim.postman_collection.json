                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('violação de NOT NULL (23502)', () => pm.expect(pm.response.json().code).to.eql('23502'));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-07 Criar ficha em nome de outra pessoa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
