              }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/characters?id=eq.{{character_id}}"
            },
            "description": "RF-06. Positivo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"occupation\": \"Teste API-08\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ocupação alterada', () => pm.expect(pm.response.json()[0].occupation).to.eql('Teste API-08'));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-09 Ler ficha e conferir persistência (CT-13)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/characters?id=eq.{{character_id}}&select=id,name,occupation"
            },
            "description": "RF-06, RNF-03."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test('valor persistido', () => { pm.expect(rows).to.have.lengthOf(1); pm.expect(rows[0].occupation).to.eql('Teste API-08'); });"
                ]
              }
            }
          ]
        },
        {
