      ]
    },
    {
      "name": "Segurança (somente ambiente de teste)",
      "item": [
        {
          "name": "API-14 Jogador tenta se promover a mestre (DEF-01)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/profiles?id=eq.{{user_id}}"
            },
            "description": "RNF-01. ATENÇÃO: rode só com conta de JOGADOR descartável e depois de API-01. Se o defeito DEF-01 ainda existir no banco, a conta VIRA MESTRE e precisa ser rebaixada no SQL Editor: update public.profiles set role = 'jogador' where id = '<id>';",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"mestre\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('recusado (401 ou 403)', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));",
                  "pm.test('sem permissão na coluna role (42501)', () => pm.expect(pm.response.json().code).to.eql('42501'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('role') !== 'jogador') { throw new Error('API-14 exige conta de jogador (rode API-01 e API-04 antes).'); }"
                ]
              }
            }
          ]
        }
      ]
    }
