# Copie para .env.local e preencha com as chaves do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Vercel Blob (uploads da Mesa). Criada ao ligar o Blob store ao projeto na Vercel.
# Local: rode `vercel env pull .env.local` ou copie o valor do painel. Só servidor: nunca use NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
